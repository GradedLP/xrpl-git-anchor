# /etc/xrpl-git-anchor.env  (root:root 0644). NO SECRETS HERE: boot refuses any seed-like value.
# The seed lives only in /etc/xrpl-git-anchor/seed (root:root 0400), handed to the service by systemd.

# systemd does not strip comments that follow a value, so keep every comment on its own line.

# --- required ---
# testnet first; switch to mainnet when you are happy (and use a new key for mainnet)
ANCHOR_NETWORK=testnet
ANCHOR_REPO_URL=https://github.com/you/your-repo.git
# the r-address printed by bin/keygen.js
ANCHOR_ACCOUNT=

# --- optional (defaults shown) ---
# ANCHOR_BRANCH=main
# ANCHOR_REPO_ID=<ANCHOR_REPO_URL without .git>    # the repo URL written into each memo
# ANCHOR_MEMO_TYPE=xrpl-git-anchor/v1              # pick your own (e.g. yourproject/anchor/v1) to tell deployments apart
# ANCHOR_SOURCE_NAME=primary                       # recorded in each memo's "src"
# ANCHOR_FALLBACK_URL=                             # second source if the primary is unreachable (e.g. a local clone)
# ANCHOR_FALLBACK_NAME=fallback
# ANCHOR_PUBLIC_DIR=                               # e.g. /var/www/anchors: index.json, latest.json, files.json
# ANCHOR_LABEL=<repo id>                           # human name in alerts and index.json
# ANCHOR_DOMAIN=                                   # e.g. example.org: sets the account Domain on the first anchor
# ANCHOR_HEARTBEAT_HOURS=24
# ANCHOR_MAX_FEE_DROPS=5000
# ANCHOR_MIN_SPENDABLE_XRP=2
# ANCHOR_RPC=https://xrplcluster.com/,https://s1.ripple.com:51234/,https://s2.ripple.com:51234/
# ANCHOR_NTFY_TOPIC=                               # optional push alerts (history rewrite, low balance, failures)
# ANCHOR_NTFY_BASE=https://ntfy.sh
# ALERT_HOST=<hostname>
